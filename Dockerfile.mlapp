# Use an official lightweight Python image
FROM python:3.9-slim

# Set environment variables for Python and logging
ENV PYTHONUNBUFFERED=1 \
    LOG_DIR=/app/logs

# Create a directory for logs and set permissions
RUN mkdir -p ${LOG_DIR} && chmod -R 777 ${LOG_DIR}

# Set the working directory inside the container
WORKDIR /app

# Copy the requirements file first to leverage Docker layer caching
COPY requirements.txt ./

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code
COPY src/ /app/src/

# Copy model files from src/models to /app/models
COPY src/models/ /app/models/

# Copy configuration files
COPY configs/ /app/configs/

# Copy data folder 
COPY data/ /app/data/

# Expose port for any API or dashboard (if applicable)
EXPOSE 5000

# Set the log directory as a volume for persistent logging
VOLUME ${LOG_DIR}

# Define the entrypoint command (modify as needed, e.g., running a script or API server)
CMD ["python", "src/predict_api.py"]