# Use an official lightweight Python image
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    LOG_DIR=/app/logs \
    PROMETHEUS_MULTIPROC_DIR=/app/prometheus_metrics

# Install system dependencies and create directories
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev curl && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p ${LOG_DIR} ${PROMETHEUS_MULTIPROC_DIR} && \
    chmod -R 777 ${LOG_DIR} ${PROMETHEUS_MULTIPROC_DIR}

# Set working directory
WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install prometheus-flask-exporter

# Copy application files
COPY src/ /app/src/
COPY src/models/ /app/models/
COPY configs/ /app/configs/
COPY data/ /app/data/

# Expose ports (removed comments to prevent parsing issues)
EXPOSE 5000
EXPOSE 5001

# Create volumes
VOLUME ${LOG_DIR} ${PROMETHEUS_MULTIPROC_DIR}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:5000/health_status || exit 1

# Entrypoint command
CMD ["python", "src/predict_api.py"]