# Use a lightweight official Python base image
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    LOG_DIR=/app/logs

# Install system packages (curl for health checks, pip for dependencies)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p ${LOG_DIR} && \
    chmod -R 777 ${LOG_DIR}

# Set working directory inside the container
WORKDIR /app

# Copy only the required source code
COPY ./src /app/src

# Copy requirements file if you need specific packages (optional step)
# COPY requirements.txt /app/
# RUN pip install -r requirements.txt

# Install only what’s needed for Prometheus monitoring
RUN pip install --no-cache-dir prometheus_client psutil

# Optional: expose metrics port
EXPOSE 8002

# Command to run your training metrics server script
CMD ["python", "/app/src/utils/monitoring.py"]
